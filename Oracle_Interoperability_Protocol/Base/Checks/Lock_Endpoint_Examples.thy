theory Lock_Endpoint_Examples
  imports "../Lock_Endpoints" "Preemptive_Lock_Correctness.Reservation_Boundaries"
begin

section \<open>Fixture generated by the public reservation machine\<close>

definition lock_example_held where
  "lock_example_held = fst (acquire_reservation (sample_source_context ACTIVE) (sample_request 17)
    (\<lambda>_. 0) 10 sample_initial)"

definition lock_example_contexts where
  "lock_example_contexts endpoint = (if endpoint = 0 then sample_source_context ACTIVE else sample_context ACTIVE)"

definition lock_example_core where
  "lock_example_core m = (initial_finality_core sample_balances (sample_metadata ACTIVE) lock_example_contexts)
    \<lparr>core_parent := m\<rparr>"

definition lock_example_world where
  "lock_example_world m = \<lparr>product_durable = \<lparr>product_authority_epoch = 9,
    product_owners = (\<lambda>_. None)(17 := Some 3),
    product_sessions = (\<lambda>_. None)(1 := Some \<lparr>session_principal = 7, session_epoch = 9\<rparr>),
    product_locks = (\<lambda>_. None), product_requests = (\<lambda>_. None)\<rparr>,
    product_calls = initial_call_machine (lock_example_core m)\<rparr>"

definition lock_example_token where
  "lock_example_token = \<lparr>credential_token = \<lparr>token_asset = 17, token_owner = 7, token_generation = 0\<rparr>,
    credential_epoch = 9, credential_origin = (0,17)\<rparr>"

definition lock_example_envelope where
  "lock_example_envelope cmd = \<lparr>envelope_message = 1, envelope_origin = (0,17), envelope_asset = 17,
    envelope_caller = 7, envelope_session = 1,
    envelope_cut = \<lparr>cut_authority_epoch = 9, cut_revision = 0\<rparr>, envelope_command = cmd\<rparr>"

definition lock_example_dispatch where
  "lock_example_dispatch = Client_Protocol 0 0 (Dispatch_Intent (sample_request 17) 0 [])"

lemmas lock_example_public_defs = lock_example_held_def sample_data_defs
  acquire_reservation_def record_observation_def commit_reservation_event_def Let_def

lemma lock_example_current_reservation:
  "asset_owner (machine_state lock_example_held) 17 = Some (0,17)"
  "map_option reservation_generation (reservation_at (machine_state lock_example_held) (0,17)) = Some 0"
  "map_option reservation_worker (reservation_at (machine_state lock_example_held) (0,17)) = Some 7"
  by (simp_all add: lock_example_public_defs)

lemma lock_example_dispatch_admitted:
  "lock_envelope_admitted 7 (lock_example_envelope lock_example_dispatch)
    (Some lock_example_token) (lock_example_world lock_example_held)"
  by (simp add: lock_example_envelope_def lock_example_dispatch_def lock_example_world_def lock_example_core_def
      lock_example_token_def initial_call_machine_def lock_envelope_admitted_def envelope_matches_request_def
      envelope_matches_binding_def lock_credential_matches_def authoritative_lock_view_def authoritative_lock_token_def
      authoritative_reservation_state_def product_lock_admitted_def current_lock_token_def current_product_cut_def
      lock_example_public_defs)

lemma lock_example_dispatch_is_fresh:
  "product_new_call 7 (7,1) (lock_example_envelope lock_example_dispatch) (lock_example_world lock_example_held)"
  by (simp add: product_new_call_def product_identity_bound_def lock_example_world_def initial_call_machine_def
      lock_example_envelope_def lock_example_dispatch_def current_product_cut_def sample_request_def)

lemma lock_example_public_dispatch_reply:
  "snd (sample.execute_finality_client lock_example_dispatch (lock_example_core lock_example_held)) =
    Protocol_Response Source_Dispatched"
  by (simp add: lock_example_dispatch_def lock_example_core_def lock_example_contexts_def current_lock_view_def
      sample.first_protocol_call_uses_the_current_core sample.invoke_protocol_def dispatch_source_def
      initial_finality_core_def lift_protocol_result_def vector_lookup_def lock_example_public_defs)

definition lock_example_submit where
  "lock_example_submit entry supplied = sample.submit_lock_entry (\<lambda>_ _ _. True) (\<lambda>_ _ _ _. True)
    entry 7 (7,1) (lock_example_envelope lock_example_dispatch) supplied (lock_example_world lock_example_held)"

lemma normal_admin_and_adapter_dispatch_with_current_credential:
  "call_authority_results (product_calls (lock_example_submit entry (Some lock_example_token))) (7,1) =
    Some (lock_example_dispatch, Protocol_Response Source_Dispatched, 0)"
proof -
  let ?envelope = "lock_example_envelope lock_example_dispatch"
  let ?world = "lock_example_world lock_example_held"
  have submit: "lock_example_submit entry (Some lock_example_token) = sample.product_submit (\<lambda>_ _ _. True) 7 (7,1) ?envelope ?world"
    unfolding lock_example_submit_def
    by (rule sample.authorized_current_entry_uses_actual_submission) (simp_all add: lock_example_dispatch_admitted)
  have run: "product_calls (sample.product_submit (\<lambda>_ _ _. True) 7 (7,1) ?envelope ?world) =
    sample.finality_calls.run_calls [Begin_Call (7,1) (envelope_command ?envelope), Dispatch_Call (7,1) (envelope_command ?envelope)]
      (product_calls ?world)"
    by (rule sample.product_new_call_uses_authoritative_dispatch) (rule TrueI, rule lock_example_dispatch_is_fresh)
  show ?thesis unfolding submit run
    by (simp only: lock_example_envelope_def lock_example_world_def product_envelope.select_convs product_world.select_convs
        sample.finality_calls.initial_dispatch_projection(2) fun_upd_same lock_example_public_dispatch_reply)
qed

lemma normal_admin_and_adapter_reject_epoch_removal_control:
  "lock_example_submit entry (Some (lock_example_token\<lparr>credential_epoch := 8\<rparr>)) = lock_example_world lock_example_held"
  unfolding lock_example_submit_def
  by (rule sample.every_lock_entry_rejects_older_authority_epoch)
    (simp add: lock_example_world_def current_product_cut_def)

definition lock_example_without_epoch where
  "lock_example_without_epoch entry supplied = lock_example_submit entry
    (Some (supplied\<lparr>credential_epoch := cut_authority_epoch (current_product_cut (lock_example_world lock_example_held))\<rparr>))"

lemma removing_epoch_check_would_admit_the_same_actual_dispatch:
  "call_authority_results (product_calls (lock_example_without_epoch entry
    (lock_example_token\<lparr>credential_epoch := 8\<rparr>))) (7,1) =
    Some (lock_example_dispatch, Protocol_Response Source_Dispatched, 0)"
proof -
  have normalized: "(lock_example_token\<lparr>credential_epoch := 8\<rparr>)\<lparr>credential_epoch :=
    cut_authority_epoch (current_product_cut (lock_example_world lock_example_held))\<rparr> = lock_example_token"
    by (simp add: lock_example_token_def lock_example_world_def current_product_cut_def)
  show ?thesis unfolding lock_example_without_epoch_def normalized
    by (rule normal_admin_and_adapter_dispatch_with_current_credential)
qed

lemma credential_holder_and_generation_are_checked:
  "lock_example_submit entry (Some (lock_example_token\<lparr>credential_token :=
    (credential_token lock_example_token)\<lparr>token_owner := 3\<rparr>\<rparr>)) = lock_example_world lock_example_held"
  "lock_example_submit entry (Some (lock_example_token\<lparr>credential_token :=
    (credential_token lock_example_token)\<lparr>token_generation := 1\<rparr>\<rparr>)) = lock_example_world lock_example_held"
  by (simp_all add: lock_example_submit_def sample.submit_lock_entry_def sample.lock_submission_allowed_def
      lock_envelope_admitted_def lock_example_envelope_def lock_example_dispatch_def lock_credential_matches_def
      product_lock_admitted_def lock_example_token_def)

lemma credential_from_another_reservation_cannot_be_reused:
  "lock_example_submit entry (Some (lock_example_token\<lparr>credential_origin := (0,23)\<rparr>)) = lock_example_world lock_example_held"
  by (simp add: lock_example_submit_def sample.submit_lock_entry_def sample.lock_submission_allowed_def
      lock_envelope_admitted_def lock_example_envelope_def lock_example_dispatch_def lock_credential_matches_def
      lock_example_token_def sample_request_def sample_binding_def example_binding_def)

lemma removing_reservation_binding_would_admit_the_same_actual_dispatch:
  "let supplied = lock_example_token\<lparr>credential_origin := (0,23)\<rparr>;
       checked = supplied\<lparr>credential_origin := envelope_origin (lock_example_envelope lock_example_dispatch)\<rparr>
   in call_authority_results (product_calls (lock_example_submit entry (Some checked))) (7,1) =
     Some (lock_example_dispatch, Protocol_Response Source_Dispatched, 0)"
proof -
  have normalized: "(lock_example_token\<lparr>credential_origin := (0,23)\<rparr>)\<lparr>credential_origin :=
    envelope_origin (lock_example_envelope lock_example_dispatch)\<rparr> = lock_example_token"
    by (simp add: lock_example_envelope_def lock_example_token_def)
  show ?thesis unfolding Let_def normalized
    by (rule normal_admin_and_adapter_dispatch_with_current_credential)
qed

lemma removing_only_holder_or_generation_check_would_admit_dispatch:
  "let wrong = lock_example_token\<lparr>credential_token := (credential_token lock_example_token)\<lparr>token_owner := 3\<rparr>\<rparr>;
       checked = wrong\<lparr>credential_token := (credential_token wrong)\<lparr>token_owner := 7\<rparr>\<rparr>
    in call_authority_results (product_calls (lock_example_submit entry (Some checked))) (7,1) =
      Some (lock_example_dispatch, Protocol_Response Source_Dispatched, 0)"
  "let wrong = lock_example_token\<lparr>credential_token := (credential_token lock_example_token)\<lparr>token_generation := 1\<rparr>\<rparr>;
       checked = wrong\<lparr>credential_token := (credential_token wrong)\<lparr>token_generation := 0\<rparr>\<rparr>
    in call_authority_results (product_calls (lock_example_submit entry (Some checked))) (7,1) =
      Some (lock_example_dispatch, Protocol_Response Source_Dispatched, 0)"
proof -
  have owner: "(let wrong = lock_example_token\<lparr>credential_token := (credential_token lock_example_token)\<lparr>token_owner := 3\<rparr>\<rparr>
    in wrong\<lparr>credential_token := (credential_token wrong)\<lparr>token_owner := 7\<rparr>\<rparr>) = lock_example_token"
    by (simp add: Let_def lock_example_token_def)
  have generation: "(let wrong = lock_example_token\<lparr>credential_token := (credential_token lock_example_token)\<lparr>token_generation := 1\<rparr>\<rparr>
    in wrong\<lparr>credential_token := (credential_token wrong)\<lparr>token_generation := 0\<rparr>\<rparr>) = lock_example_token"
    by (simp add: Let_def lock_example_token_def)
  show "let wrong = lock_example_token\<lparr>credential_token := (credential_token lock_example_token)\<lparr>token_owner := 3\<rparr>\<rparr>;
       checked = wrong\<lparr>credential_token := (credential_token wrong)\<lparr>token_owner := 7\<rparr>\<rparr>
    in call_authority_results (product_calls (lock_example_submit entry (Some checked))) (7,1) =
      Some (lock_example_dispatch, Protocol_Response Source_Dispatched, 0)"
    unfolding Let_def owner[unfolded Let_def]
    by (rule normal_admin_and_adapter_dispatch_with_current_credential)
  show "let wrong = lock_example_token\<lparr>credential_token := (credential_token lock_example_token)\<lparr>token_generation := 1\<rparr>\<rparr>;
       checked = wrong\<lparr>credential_token := (credential_token wrong)\<lparr>token_generation := 0\<rparr>\<rparr>
    in call_authority_results (product_calls (lock_example_submit entry (Some checked))) (7,1) =
      Some (lock_example_dispatch, Protocol_Response Source_Dispatched, 0)"
    unfolding Let_def generation[unfolded Let_def]
    by (rule normal_admin_and_adapter_dispatch_with_current_credential)
qed

end
